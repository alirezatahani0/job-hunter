ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5
# Used for Tailor resume and Write cover letter
# Base CV: cleaned markdown derived from your PDF (or point at the PDF directly)
CV_PATH=data/alireza_tahani_cv.md
# CV_PATH=data/Alireza 2026 resume (2).pdf
# Trello board Job Search. Token is from the Power-Up authorize page, not the secret.
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=
# Phone is for employer form fields only. It is not written on the resume or cover letter.
APPLICANT_PHONE=
# Optional. The 10:00 and 15:00 job reads mail only when all three are set.
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
